module Lock_Controller (
    input  wire       CLOCK_50,
    input  wire       reset_n,    // Kết nối với KEY[0]
    
    input  wire [3:0] key_data,
    input  wire       key_valid,
    
    output reg  [2:0] lcd_status,
    output reg        update_digit,
    output reg        update_status
);
    // Mật khẩu mặc định 0-0-0-0
    reg [15:0] saved_pass = 16'h0000; 
    reg [15:0] entered_pass = 0;
    reg [2:0]  state = 3'd0;
    reg [2:0]  digit_count = 0;
    reg [2:0]  wrong_count = 0;
    reg [29:0] delay_timer = 0;

    localparam S0_ENTER_PASS   = 3'd0;
    localparam S1_UNLOCK       = 3'd1;
    localparam S2_LOCK_PENALTY = 3'd2;
    localparam S3_NEW_PASS     = 3'd3;
    localparam S4_WRONG        = 3'd4;

    localparam [29:0] TIME_3S  = 30'd150_000_000;
    localparam [29:0] TIME_15S = 30'd750_000_000;

    // --- Bộ chống dội phím (Debounce 0.5s) ---
    reg valid_sync1, valid_sync2, valid_prev;
    wire valid_key_action;
    localparam [24:0] DEBOUNCE_TIME = 25'd25_000_000; 
    reg [24:0] debounce_timer = 0;
    reg input_locked = 0;

    always @(posedge CLOCK_50) begin
        valid_sync1 <= key_valid;
        valid_sync2 <= valid_sync1;
        valid_prev  <= valid_sync2;
        
        if (input_locked) begin
            if (debounce_timer < DEBOUNCE_TIME) debounce_timer <= debounce_timer + 1;
            else input_locked <= 0;
        end else if (valid_sync2 && !valid_prev) begin
            input_locked <= 1;
            debounce_timer <= 0;
        end
    end
    assign valid_key_action = (valid_sync2 && !valid_prev && !input_locked);

    // --- FSM ĐIỀU KHIỂN ---
    always @(posedge CLOCK_50) begin
        if (update_digit)  update_digit  <= 0;
        if (update_status) update_status <= 0;

        // CẢI TIẾN: Reset về trạng thái ban đầu (Ngoại trừ khi đang bị phạt)
        if (!reset_n && state != S2_LOCK_PENALTY) begin
            state         <= S0_ENTER_PASS;
            lcd_status    <= S0_ENTER_PASS;
            digit_count   <= 0;
            wrong_count   <= 0;
            entered_pass  <= 0;
            delay_timer   <= 0;
            update_status <= 1; // Kích hoạt làm mới LCD
        end else begin
            case (state)
                S0_ENTER_PASS: begin
                    if (valid_key_action && key_data >= 4'h0 && key_data <= 4'h9) begin
                        entered_pass <= {entered_pass[11:0], key_data};
                        digit_count  <= digit_count + 1;
                        update_digit <= 1;
                        
                        if (digit_count == 3) begin 
                            if ({entered_pass[11:0], key_data} == saved_pass) begin
                                state       <= S1_UNLOCK;
                                lcd_status  <= S1_UNLOCK;
                                wrong_count <= 0;
                            end else begin
                                wrong_count <= wrong_count + 1;
                                if (wrong_count == 3) begin
                                    state      <= S2_LOCK_PENALTY;
                                    lcd_status <= S2_LOCK_PENALTY;
                                end else begin
                                    state      <= S4_WRONG;
                                    lcd_status <= S4_WRONG;
                                end
                            end
                            update_status <= 1;
                            digit_count   <= 0;
                            delay_timer   <= 0;
                        end
                    end
                end

                S1_UNLOCK: begin
                    if (valid_key_action) begin
                        if (key_data == 4'hE) begin // '*' để đổi pass
                            state        <= S3_NEW_PASS;
                            lcd_status   <= S3_NEW_PASS;
                            update_status<= 1;
                            entered_pass <= 0;
                            digit_count  <= 0;
                        end
                        else if (key_data == 4'hF) begin // '#' để khóa lại
                            state        <= S0_ENTER_PASS;
                            lcd_status   <= S0_ENTER_PASS;
                            update_status<= 1;
                            entered_pass <= 0;
                        end
                    end
                end

                S3_NEW_PASS: begin
                    if (valid_key_action) begin
                        if (key_data >= 4'h0 && key_data <= 4'h9 && digit_count < 4) begin
                            entered_pass <= {entered_pass[11:0], key_data};
                            digit_count  <= digit_count + 1;
                            update_digit <= 1;
                        end
                        else if (key_data == 4'hE && digit_count == 4) begin
                            saved_pass   <= entered_pass;
                            state        <= S0_ENTER_PASS; // Về Enter Pass sau khi đổi
                            lcd_status   <= S0_ENTER_PASS;
                            update_status<= 1;
                            entered_pass <= 0;
                            digit_count  <= 0;
                        end
                    end
                end

                S4_WRONG: begin
                    if (delay_timer < TIME_3S) delay_timer <= delay_timer + 1;
                    else begin
                        state <= S0_ENTER_PASS; lcd_status <= S0_ENTER_PASS;
                        update_status <= 1; entered_pass <= 0;
                    end
                end

                S2_LOCK_PENALTY: begin
                    if (delay_timer < TIME_15S) delay_timer <= delay_timer + 1;
                    else begin
                        state <= S0_ENTER_PASS; lcd_status <= S0_ENTER_PASS;
                        wrong_count <= 0; update_status <= 1; entered_pass <= 0;
                        delay_timer <= 0;
                    end
                end
                default: state <= S0_ENTER_PASS;
            endcase
        end
    end
endmodule